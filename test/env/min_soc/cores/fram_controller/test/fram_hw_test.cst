// Pines de la prueba en hardware del controlador FRAM (GW2AR-LV18EQ144)
// Fuente: FPGBC_digital_UN/docs/identified_pins/gowin_ar_lv18e144pc.csv

// Reloj 40 MHz
IO_LOC "clk" 11;
IO_PORT "clk" IO_TYPE=LVCMOS33;

// Reset: botón de volumen (pull-up)
IO_LOC "resetn" 120;
IO_PORT "resetn" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// UART por el puerto Link
IO_LOC "TXD" 28;
IO_PORT "TXD" IO_TYPE=LVCMOS33;
IO_LOC "RXD" 27;
IO_PORT "RXD" IO_TYPE=LVCMOS33;

// Cartucho: control (vía buffer de control)
IO_LOC "cart_wr_n" 61;
IO_PORT "cart_wr_n" IO_TYPE=LVCMOS33;
IO_LOC "cart_rd_n" 62;
IO_PORT "cart_rd_n" IO_TYPE=LVCMOS33;
IO_LOC "cart_cs_n" 63;
IO_PORT "cart_cs_n" IO_TYPE=LVCMOS33;

// Habilitación del buffer de control (OE YF04E) y dirección del buffer de datos (DIR LJ24SA)
IO_LOC "cart_cmd_oe" 48;
IO_PORT "cart_cmd_oe" IO_TYPE=LVCMOS33;
IO_LOC "cart_data_dir" 59;
IO_PORT "cart_data_dir" IO_TYPE=LVCMOS33;

// Cartucho: direcciones A0-A15
IO_LOC "cart_addr[0]" 64;
IO_PORT "cart_addr[0]" IO_TYPE=LVCMOS33;
IO_LOC "cart_addr[1]" 65;
IO_PORT "cart_addr[1]" IO_TYPE=LVCMOS33;
IO_LOC "cart_addr[2]" 66;
IO_PORT "cart_addr[2]" IO_TYPE=LVCMOS33;
IO_LOC "cart_addr[3]" 67;
IO_PORT "cart_addr[3]" IO_TYPE=LVCMOS33;
IO_LOC "cart_addr[4]" 68;
IO_PORT "cart_addr[4]" IO_TYPE=LVCMOS33;
IO_LOC "cart_addr[5]" 69;
IO_PORT "cart_addr[5]" IO_TYPE=LVCMOS33;
IO_LOC "cart_addr[6]" 70;
IO_PORT "cart_addr[6]" IO_TYPE=LVCMOS33;
IO_LOC "cart_addr[7]" 71;
IO_PORT "cart_addr[7]" IO_TYPE=LVCMOS33;
IO_LOC "cart_addr[8]" 72;
IO_PORT "cart_addr[8]" IO_TYPE=LVCMOS33;
IO_LOC "cart_addr[9]" 76;
IO_PORT "cart_addr[9]" IO_TYPE=LVCMOS33;
IO_LOC "cart_addr[10]" 78;
IO_PORT "cart_addr[10]" IO_TYPE=LVCMOS33;
IO_LOC "cart_addr[11]" 79;
IO_PORT "cart_addr[11]" IO_TYPE=LVCMOS33;
IO_LOC "cart_addr[12]" 80;
IO_PORT "cart_addr[12]" IO_TYPE=LVCMOS33;
IO_LOC "cart_addr[13]" 82;
IO_PORT "cart_addr[13]" IO_TYPE=LVCMOS33;
IO_LOC "cart_addr[14]" 83;
IO_PORT "cart_addr[14]" IO_TYPE=LVCMOS33;
IO_LOC "cart_addr[15]" 84;
IO_PORT "cart_addr[15]" IO_TYPE=LVCMOS33;

// Cartucho: datos D0-D7 (vía buffer de datos)
IO_LOC "cart_d[0]" 45;
IO_PORT "cart_d[0]" IO_TYPE=LVCMOS33;
IO_LOC "cart_d[1]" 44;
IO_PORT "cart_d[1]" IO_TYPE=LVCMOS33;
IO_LOC "cart_d[2]" 43;
IO_PORT "cart_d[2]" IO_TYPE=LVCMOS33;
IO_LOC "cart_d[3]" 42;
IO_PORT "cart_d[3]" IO_TYPE=LVCMOS33;
IO_LOC "cart_d[4]" 41;
IO_PORT "cart_d[4]" IO_TYPE=LVCMOS33;
IO_LOC "cart_d[5]" 40;
IO_PORT "cart_d[5]" IO_TYPE=LVCMOS33;
IO_LOC "cart_d[6]" 39;
IO_PORT "cart_d[6]" IO_TYPE=LVCMOS33;
IO_LOC "cart_d[7]" 38;
IO_PORT "cart_d[7]" IO_TYPE=LVCMOS33;
